{
  "manifest_version": 3,
  "name": "BrowShare Remote Tab",
  "version": "0.1.23",
  "description": "Publishes an Embedder-authorized Chrome tab through BrowShare Remote Tab.",
  "permissions": ["debugger", "offscreen", "storage", "tabCapture", "tabs"],
  "host_permissions": ["http://127.0.0.1/*", "http://[::1]/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "storage": {
    "managed_schema": "managed-schema.json"
  }
}
