{
  "name": "@browshare/remote-tab-extension",
  "version": "0.1.25",
  "description": "Chrome extension contracts for BrowShare Remote Tab",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x3zvawq/browshare-remote-tab.git",
    "directory": "packages/extension"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.ts && node scripts/check-chrome-artifact.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "check:exports": "publint"
  },
  "dependencies": {
    "@browshare/remote-tab-protocol": "workspace:*"
  }
}
