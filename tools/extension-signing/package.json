{
  "name": "@browshare/remote-tab-extension-signing",
  "version": "0.1.25",
  "description": "Signing and managed-policy contract types for the Remote Tab extension",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x3zvawq/browshare-remote-tab.git",
    "directory": "tools/extension-signing"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "main": "./dist/index.mjs",
