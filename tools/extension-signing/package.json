  "types": "./dist/index.d.mts",
  "bin": {
    "browshare-extension": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "check:exports": "publint"
  },
  "dependencies": {
    "fflate": "catalog:"
  }
}
