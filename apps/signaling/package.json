{
  "name": "@browshare/remote-tab-signaling",
  "version": "0.1.25",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "bin": {
    "browshare-remote-tab-signaling": "./dist/cli.mjs"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/cli.ts --format esm --dts --clean",
    "start": "node dist/cli.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@browshare/remote-tab-protocol": "workspace:*",
    "typebox": "catalog:",
    "ws": "catalog:"
  }
}
